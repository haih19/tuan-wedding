---
import { wedding } from '../config/wedding';
import Photo from './Photo.astro';
import type { Side } from '../types/wedding';
interface Props {
  side: Side;
}
const people = (['groom', 'bride'] as const).map((side) => ({
  ...wedding.couple[side],
  label: side === 'groom' ? 'Chú rể' : 'Cô dâu',
}));
---

<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="couple">
      {
        people.map((person) => (
          <article class="portrait">
            <Photo
              src={person.portrait}
              alt={person.name}
              widths={[300, 600]}
              sizes="(max-width:700px) 45vw, 420px"
              formats={['webp']}
              loading="lazy"
            />
            <p class="caps">{person.label}</p>
            <h3>{person.name}</h3>
            {person.parents.map((parent) => (
              <p>{parent}</p>
            ))}
          </article>
        ))
      }
    </div>
  </div>
</section>
